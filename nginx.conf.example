# fandai — nginx reverse proxy for Ubuntu 22.04
#
# Terminates HTTPS and proxies to the loopback-bound gateway on 127.0.0.1:8000.
# Client API-key authentication is enforced by the app itself (FANDAI_API_KEY);
# nginx only handles TLS, header forwarding, and SSE streaming behaviour.
#
# Install:
#   sudo cp nginx.conf.example /etc/nginx/sites-available/fandai
#   sudo ln -s /etc/nginx/sites-available/fandai /etc/nginx/sites-enabled/fandai
#   sudo rm -f /etc/nginx/sites-enabled/default
#   # Provision a certificate (e.g. certbot) for your domain, then:
#   sudo nginx -t && sudo systemctl reload nginx

upstream fandai_gateway {
    server 127.0.0.1:8000;
    keepalive 32;
}

# Redirect plain HTTP to HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name your-domain.example.com;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name your-domain.example.com;

    # --- TLS ------------------------------------------------------------------
    # Replace with your real certificate paths (certbot writes these under
    # /etc/letsencrypt/live/<domain>/).
    ssl_certificate     /etc/letsencrypt/live/your-domain.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-domain.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # Allow large request bodies (long prompts / conversation history).
    client_max_body_size 25m;

    # --- Inference endpoints (SSE-capable) ------------------------------------
    # All three protocols share identical proxy behaviour: streaming responses
    # must not be buffered, and connections stay open for long-lived SSE.
    location = /v1/chat/completions {
        proxy_pass http://fandai_gateway;

        proxy_http_version 1.1;
        proxy_set_header Connection "";

        # Forward original client information to the app.
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Stream Server-Sent Events immediately — do not buffer or cache.
        proxy_buffering    off;
        proxy_cache        off;
        proxy_set_header   X-Accel-Buffering no;

        # Generous timeouts for slow upstream generation and idle SSE streams.
        proxy_connect_timeout 30s;
        proxy_send_timeout    600s;
        proxy_read_timeout    600s;
    }

    location = /v1/responses {
        proxy_pass http://fandai_gateway;

        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering    off;
        proxy_cache        off;
        proxy_set_header   X-Accel-Buffering no;

        proxy_connect_timeout 30s;
        proxy_send_timeout    600s;
        proxy_read_timeout    600s;
    }

    location = /v1/messages {
        proxy_pass http://fandai_gateway;

        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering    off;
        proxy_cache        off;
        proxy_set_header   X-Accel-Buffering no;

        proxy_connect_timeout 30s;
        proxy_send_timeout    600s;
        proxy_read_timeout    600s;
    }

    # --- Health checks --------------------------------------------------------
    location = /healthz {
        proxy_pass http://fandai_gateway;
        proxy_set_header Host $host;
    }
    location = /readyz {
        proxy_pass http://fandai_gateway;
        proxy_set_header Host $host;
    }
}
