# Copy to .env and edit. docker compose reads this file automatically.
#
# Client API key for the /v1/* inference endpoints. Clients must send it as
# either:
#     Authorization: Bearer YOUR_KEY
#     x-api-key: YOUR_KEY
#
# Leave empty (or remove the file) to disable client authentication entirely.
# Generate a strong random value, e.g.:  openssl rand -hex 32
FANDAI_API_KEY=replace-with-a-long-random-secret
